# Copy to .env.local for local development. Never commit real values.

# Database (Neon)
DATABASE_URL="postgres://..."

# Pipeline (GitHub Actions secrets/variables in production, SPEC §9.1)
CLAUDE_CODE_OAUTH_TOKEN=""          # from `claude setup-token`; not needed locally if you're logged in
RAPIDAPI_KEY=""                     # JSearch; jobs are skipped when empty
SEC_USER_AGENT="Your Name you@example.com"
ANALYSIS_BACKEND="claude-code"      # or "api"
CLAUDE_CODE_MODEL="sonnet"
ANTHROPIC_API_KEY=""                # only for ANALYSIS_BACKEND=api
ANTHROPIC_MODEL="claude-haiku-5-5"
MAX_ANALYSES_PER_RUN="60"
ANALYSIS_CONCURRENCY="1"
FORM_D_MIN_OFFERING="2000000"
JOBS_RUN_EVERY_N_DAYS="1"

# Dashboard (Vercel, SPEC §9.2)
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
ALLOWED_EMAIL_DOMAINS="company.com"
